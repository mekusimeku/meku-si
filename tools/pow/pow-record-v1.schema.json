  "$id": "https://github.com/mekusimeku/meku-si/blob/main/tools/pow/pow-record-v1.schema.json",
  "title": "MEKU proof-of-work pilot record (meku.pow/1)",
  "description": "Generated by tools/pow/record.mjs schema from tools/pow/lib.mjs. Cross-record rules (order, authorship, hashes, timing) are enforced by tools/pow/verify.mjs and described in docs/proof-of-work/records.md.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pow",
        "pilot_id",
        "type",
        "role",
        "seq",
        "protocol",
        "mcp_endpoint",
        "variant",
        "roster",
        "task",
        "payment"
      ],
      "properties": {
        "pow": {
          "const": "meku.pow/1"
        },
        "pilot_id": {
          "type": "string",
          "pattern": "^POW-(?:\\d{3}|SYNTHETIC-[A-Z0-9-]{1,30})$"
        },
        "type": {
          "const": "pilot_opened"
        },
        "role": {
          "enum": [
            "operator"
          ]
        },
        "seq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 99
        },
        "protocol": {
          "type": "string",
          "minLength": 20,
          "maxLength": 300,
          "allOf": [
            {
              "pattern": "^(?!.*(?:<!--|-->|```|~~~))[^\\u0000-\\u001f\\u007f-\\u009f\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]*$"
            },
            {
              "pattern": "^https://"
            }
          ]
        },
        "mcp_endpoint": {
          "const": "https://meku.farm/api/public/mcp"
        },
        "variant": {
          "const": "operator-relayed"
        },
        "roster": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "developer"
          ],
          "properties": {
            "operator": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}|synthetic_[a-z]{1,30})$"
            },
            "developer": {
              "type": "string",
              "pattern": "^(?:[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}|synthetic_[a-z]{1,30})$"
            }
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "code_alphabet",
            "code_length",
            "objects",
            "evidence_hours_after_reveal",
            "cycle_hours"
          ],
          "properties": {
            "kind": {
              "const": "fresh-code-photo"
            },
            "code_alphabet": {
              "const": "0123456789ABCDEFGHJKMNPQRSTVWXYZ"
            },
            "code_length": {
              "const": 8
            },
            "objects": {
              "const": [
                "SPOON",
                "CUP",
                "PLATE",
                "BOWL",
                "SOCK",
                "TOWEL",
                "PEN",
                "SHOE"
              ]
            },
            "evidence_hours_after_reveal": {
              "const": 48
            },
            "cycle_hours": {
              "const": 168
            }
          }
        },
        "payment": {
          "const": "none"
        }
      }
    },
